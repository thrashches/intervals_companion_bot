SECRET_KEY=change-me-django-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Docker Compose (default). For local sqlite: DATABASE_URL=sqlite:///./db.sqlite3
DATABASE_URL=postgres://intervals:intervals@db:5432/intervals_companion
REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
INTERNAL_API_TOKEN=uFcdFfZNDmFan606dUc5-80WquMd5qrXD42yb7teNaU
FERNET_KEY=0RIWxZ0iw0C1g1NRXQh-xoKit7sito-Qn6_8Qtls4ao=

INTERVALS_API_BASE=https://intervals.icu/api/v1
BACKEND_URL=http://backend:8000

# DeepSeek (AI-оценка в отчётах для пользователей с активной подпиской)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Для reasoning-моделей (deepseek-v4-pro и т.п.) нужно больше токенов:
# иначе reasoning съедает лимит и content остаётся пустым.
DEEPSEEK_MAX_TOKENS=4096
# Таймаут чтения ответа (сек). Для deepseek-v4-pro лучше 180+.
DEEPSEEK_TIMEOUT=180

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
